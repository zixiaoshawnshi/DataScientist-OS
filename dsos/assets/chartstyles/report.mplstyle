# For charts destined for a published report (publish_report embeds them
# at report page width): the dark house look at report scale — larger type,
# higher output resolution, heavier lines. Same palette as the default so
# a report and its inline scratch charts never mismatch.

figure.dpi       : 110
savefig.dpi      : 200
figure.facecolor : "#141a22"
savefig.facecolor: "#141a22"
axes.facecolor   : "#141a22"
text.color       : "#dce3ed"
axes.labelcolor  : "#dce3ed"
axes.edgecolor   : "#4c5566"
axes.linewidth   : 1.0
xtick.color      : "#aab3c2"
ytick.color      : "#aab3c2"
font.size        : 13
axes.titlesize   : 15
axes.labelsize   : 13
xtick.labelsize  : 12
ytick.labelsize  : 12
legend.fontsize  : 12
axes.titleweight : bold
axes.titlepad    : 12

axes.grid        : True
grid.color       : "#27303d"
grid.linewidth   : 0.7

axes.spines.top  : False
axes.spines.right: False

axes.prop_cycle  : cycler('color', ["#89b4f7", "#f5a35c", "#7fd0a5", "#e28fb1", "#a99df2", "#66d4cf", "#d9c468", "#9aa3b2"])

lines.linewidth  : 2.2
lines.markersize : 6.5

legend.frameon   : False
